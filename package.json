{
  "name": "@mitchallen/maze-generator-v2",
  "version": "0.2.3",
  "description": "maze generator",
  "main": "dist/maze-generator-v2.js",
  "scripts": {
    "//": "To use: npm run test-nodemon (assumes global location of mocha)",
    "start": "node dist/maze-generator-v2.js",
    "test": "grunt && mocha --recursive --timeout 20000",
    "test-nodemon": "nodemon mocha --recursive --timeout 5000",
    "test-hexagon": "grunt && mocha --recursive test/hexagon/ --timeout 5000",
    "test-square": "grunt && mocha --recursive test/square/ --timeout 5000",
    "test-triangle": "grunt && mocha --recursive test/triangle/ --timeout 5000",
    "test-circle": "grunt && mocha --recursive test/circle/ --timeout 5000",
    "test-ascii": "grunt && mocha --recursive test/ascii/ --timeout 5000",
    "test-debug": "grunt && mocha -g '@DEBUG' --recursive --timeout 20000",
    "test-jenkins": "grunt && mocha --recursive --timeout 20000 -R xunit test/ > test-reports.xml",
    "ws:install": "npm install --workspaces",
    "ws:test": "npm run test --workspaces --if-present",
    "ws:build": "npm run build --workspaces --if-present",
    "ws:clean": "npm run clean --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchallen/maze-generator-v2.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babelify": "^10.0.0",
    "browserify-derequire": "^0.9.4",
    "grunt": "^1.0.1",
    "grunt-browserify": "^6.0.0",
    "grunt-bump": "^0.8.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-terser": "^2.0.0",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-shell": "^1.3.0",
    "mocha": "^11.7.5",
    "should": "^10.0.0",
    "superagent": "^10.3.0",
    "supertest": "^7.2.2",
    "yargs-parser": "^22.0.0"
  },
  "dependencies": {
    "connection-grid": "^0.1.34",
    "connection-grid-square": "^0.1.17",
    "maze-generator-core": "^0.1.13",
    "maze-generator-square": "^0.1.24"
  },
  "overrides": {
    "braces": "^3.0.3",
    "diff": "^8.0.3",
    "elliptic": "^6.6.1",
    "trim-newlines": "^5.0.0",
    "yargs-parser": "^22.0.0",
    "minimatch": "^3.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
