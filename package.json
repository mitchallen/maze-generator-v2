{
  "name": "@mitchallen/maze-generator-v2",
  "version": "0.3.7",
  "description": "maze generator",
  "main": "dist/maze-generator-v2.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/maze-generator-v2.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "coverage": "npm run build && c8 --check-coverage --100 --include='src/**' --reporter=text mocha --recursive --timeout 20000",
    "test-hexagon": "npm run build && mocha --recursive test/hexagon/ --timeout 5000",
    "test-square": "npm run build && mocha --recursive test/square/ --timeout 5000",
    "test-weave": "npm run build && mocha --recursive test/weave/ --timeout 5000",
    "test-triangle": "npm run build && mocha --recursive test/triangle/ --timeout 5000",
    "test-circle": "npm run build && mocha --recursive test/circle/ --timeout 5000",
    "test-ascii": "npm run build && mocha --recursive test/ascii/ --timeout 5000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000",
    "ws:install": "npm install --workspaces",
    "ws:test": "npm run test --workspaces --if-present",
    "ws:build": "npm run build --workspaces --if-present",
    "ws:clean": "npm run clean --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchallen/maze-generator-v2.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "devDependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.22",
    "@mitchallen/connection-grid-v2": "^0.1.40",
    "@mitchallen/grid-v2": "^0.1.31",
    "@mitchallen/maze-generator-core-v2": "^0.1.18",
    "@mitchallen/maze-generator-square-v2": "^0.1.28",
    "@mitchallen/maze-generator-weave-v2": "^0.1.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "should": "^13.2.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "diff": "^9.0.0",
    "js-yaml": "^4.3.2",
    "serialize-javascript": "^7.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
