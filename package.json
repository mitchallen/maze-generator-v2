{
  "name": "@mitchallen/maze-generator-v2",
  "version": "0.3.7",
  "description": "maze generator",
  "main": "dist/maze-generator-v2.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/maze-generator-v2.cjs.js",
    "build": "node build.js",
    "test": "npm run build && node --test 'test/**/*.js'",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' 'test/**/*.js'",
    "test-hexagon": "npm run build && node --test 'test/hexagon/**/*.js'",
    "test-square": "npm run build && node --test 'test/square/**/*.js'",
    "test-weave": "npm run build && node --test 'test/weave/**/*.js'",
    "test-triangle": "npm run build && node --test 'test/triangle/**/*.js'",
    "test-circle": "npm run build && node --test 'test/circle/**/*.js'",
    "test-ascii": "npm run build && node --test 'test/ascii/**/*.js'",
    "test-debug": "npm run build && node --test --test-name-pattern='@DEBUG' 'test/**/*.js'",
    "ws:install": "npm install --workspaces",
    "ws:test": "npm run test --workspaces --if-present",
    "ws:build": "npm run build --workspaces --if-present",
    "ws:clean": "npm run clean --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchallen/maze-generator-v2.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "devDependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.22",
    "@mitchallen/connection-grid-v2": "^0.1.40",
    "@mitchallen/grid-v2": "^0.1.31",
    "@mitchallen/maze-generator-core-v2": "^0.1.18",
    "@mitchallen/maze-generator-square-v2": "^0.1.28",
    "@mitchallen/maze-generator-weave-v2": "^0.1.0",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "js-yaml": "^4.3.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
