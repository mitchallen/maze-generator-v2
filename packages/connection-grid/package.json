{
  "name": "connection-grid",
  "version": "0.1.34",
  "description": "map connections between cells in a 2D grid",
  "main": "dist/connection-grid.cjs.js",
  "scripts": {
    "start": "node dist/connection-grid.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "test-create": "npm run build && mocha test/create/ --recursive --timeout 5000",
    "test-circle": "npm run build && mocha test/circle/ --recursive --timeout 5000",
    "test-hexagon": "npm run build && mocha test/hexagon/ --recursive --timeout 5000",
    "test-square": "npm run build && mocha test/square/ --recursive --timeout 5000",
    "test-triangle": "npm run build && mocha test/triangle/ --recursive --timeout 5000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/connection-grid.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.12",
    "mocha": "^11.7.6",
    "should": "^10.0.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "connection-grid-square": "^0.1.17",
    "grid": "^0.1.25",
    "grid-square": "^0.1.9",
    "shuffle": "^0.1.10"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
