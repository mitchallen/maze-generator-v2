{
  "name": "@mitchallen/connection-grid-v2",
  "version": "0.1.41",
  "description": "map connections between cells in a 2D grid (internal package of maze-generator-v2; not published)",
  "main": "src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "start": "node src/index.js",
    "build": "node build.js",
    "lint": "eslint src/",
    "test": "node build.js && node --test $(find test -name '*-test.js' | sort)",
    "coverage": "node build.js && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' $(find test -name '*-test.js' | sort)",
    "watch": "node build.js --watch",
    "test-circle": "node --test $(find test/circle   -name '*-test.js')",
    "test-create": "node --test $(find test/create   -name '*-test.js')",
    "test-hexagon": "node --test $(find test/hexagon  -name '*-test.js')",
    "test-square": "node --test $(find test/square   -name '*-test.js')",
    "test-triangle": "node --test $(find test/triangle -name '*-test.js')",
    "test-debug": "node --test $(find test -name '*-test.js' | sort)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/connection-grid"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.20",
    "@mitchallen/grid-v2": "^0.1.29",
    "@mitchallen/grid-square-v2": "^0.1.13",
    "@mitchallen/shuffle-v2": "^0.1.14"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
}
