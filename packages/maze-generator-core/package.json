  "license": "ISC",
  "devDependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.17",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
