{
  "name": "grid",
  "version": "0.1.25",
  "description": "A 2D grid that uses zero-based indexing",
  "main": "dist/grid.cjs.js",
  "scripts": {
    "start": "node dist/grid.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "test-hexagon": "npm run build && mocha --recursive test/hexagon/ --timeout 5000",
    "test-square": "npm run build && mocha --recursive test/square/ --timeout 5000",
    "test-circle": "npm run build && mocha --recursive test/circle/ --timeout 5000",
    "test-triangle": "npm run build && mocha --recursive test/triangle/ --timeout 5000",
    "test-create": "npm run build && mocha --recursive test/create/ --timeout 5000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/grid.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.12",
    "mocha": "^11.7.6",
    "should": "^10.0.0"
  },
  "dependencies": {
    "grid-core": "^0.1.10",
    "grid-square": "^0.1.9"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
