{
  "name": "@mitchallen/maze-generator-weave-v2",
  "version": "0.1.0",
  "description": "weave maze generator (internal package of maze-generator-v2; not published)",
  "main": "dist/maze-generator-weave.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "//": "Usage:> [PORT=8002] npm run web-server",
    "start": "node dist/maze-generator-weave.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "coverage": "npm run build && c8 --check-coverage --100 --include='src/**' --reporter=text mocha --recursive --timeout 20000",
    "test-weave": "npm run build && mocha test/weave/ --recursive --timeout 5000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000",
    "web-server": "python3 -m http.server ${PORT:-8000}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/maze-generator-weave"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.17",
    "@mitchallen/maze-generator-core-v2": "^0.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "should": "^13.2.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
