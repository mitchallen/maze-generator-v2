{
  "name": "@mitchallen/grid-square-v2",
  "version": "0.1.16",
  "description": "2D square grid (internal package of maze-generator-v2; not published)",
  "main": "dist/grid-square.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/grid-square.js",
    "build": "node esbuild.config.js",
    "test": "npm run build && node --test",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**'",
    "test-debug": "npm run build && node --test --test-name-pattern='@DEBUG'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/grid-square"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "dependencies": {
    "@mitchallen/grid-core-v2": "^0.1.10"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
}
