{
  "name": "@mitchallen/shuffle-v2",
  "version": "0.1.17",
  "description": "Uses Fisher-Yates to shuffle an array (internal package of maze-generator-v2; not published)",
  "main": "dist/shuffle.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/shuffle.cjs.js",
    "build": "node build.js",
    "test": "npm run build && node --test 'test/**/*.js'",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='modules/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' 'test/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/shuffle"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
}
