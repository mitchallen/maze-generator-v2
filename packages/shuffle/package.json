{
  "name": "shuffle",
  "version": "0.1.10",
  "description": "Uses Fisher-Yates to shuffle an array",
  "main": "dist/shuffle.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/shuffle.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/shuffle.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.12",
    "mocha": "^11.7.6",
    "should": "^10.0.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
