{
  "name": "@mitchallen/connection-grid-core",
  "version": "0.1.28",
  "description": "Connection grid core",
  "main": "src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "start": "node src/index.js",
    "build": "node build.js",
    "lint": "eslint src/",
    "test": "node build.js && node --test $(find test -name '*-test.js' | sort)",
    "coverage": "node build.js && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' $(find test -name '*-test.js' | sort)",
    "watch": "node build.js --watch",
    "test-debug": "node --test $(find test -name '*-test.js' | sort)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/connection-grid-core"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "dependencies": {
    "@mitchallen/shuffle": "^0.1.14"
  },
  "devDependencies": {
    "@mitchallen/grid-core": "^0.1.10",
    "@mitchallen/grid-square": "^0.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
