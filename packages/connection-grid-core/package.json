{
  "name": "connection-grid-core",
  "version": "0.1.22",
  "description": "Connection grid core",
  "main": "dist/connection-grid-core.cjs.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/connection-grid-core.cjs.js",
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "coverage": "npm run build && c8 --check-coverage --100 --include='src/**' --reporter=text mocha --recursive --timeout 20000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/connection-grid-core.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "shuffle": "^0.1.10"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "grid-core": "^0.1.10",
    "grid-square": "^0.1.9",
    "mocha": "^12.0.2",
    "should": "^13.2.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
