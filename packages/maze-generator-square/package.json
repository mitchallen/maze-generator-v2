{
  "name": "@mitchallen/maze-generator-square-v2",
  "version": "0.1.29",
  "description": "square maze generator (internal package of maze-generator-v2; not published)",
  "main": "dist/maze-generator-square.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "npm run build && node --test 'test/**/*.js'",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' 'test/**/*.js'",
    "test-square": "npm run build && node --test 'test/square/**/*.js'",
    "test-debug": "npm run build && node --test --test-name-pattern='@DEBUG' 'test/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/maze-generator-square"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "dependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.17",
    "@mitchallen/maze-generator-core-v2": "^0.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
}
