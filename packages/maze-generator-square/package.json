{
  "name": "@mitchallen/maze-generator-square-v2",
  "version": "0.1.29",
  "description": "square maze generator (internal package of maze-generator-v2; not published)",
  "main": "dist/maze-generator-square.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "npm run build && mocha --recursive --timeout 20000",
    "coverage": "npm run build && c8 --check-coverage --100 --include='src/**' --reporter=text mocha --recursive --timeout 20000",
    "test-square": "npm run build && mocha test/square/ --recursive --timeout 5000",
    "test-debug": "npm run build && mocha -g '@DEBUG' --recursive --timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator-v2.git",
    "directory": "packages/maze-generator-square"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "dependencies": {
    "@mitchallen/connection-grid-square-v2": "^0.1.17",
    "@mitchallen/maze-generator-core-v2": "^0.1.13"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "mocha": "^12",
    "should": "^13.2.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "private": true
}
