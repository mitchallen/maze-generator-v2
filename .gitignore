node_modules/
packages/*/node_modules/
# npm workspaces uses a single root lockfile; per-package lockfiles are
# unused, and stale ones triggered hundreds of spurious Dependabot alerts.
packages/*/package-lock.json
# workspace package dist/ are build artifacts (rebuilt by `make build`);
# only the ROOT dist/ is committed (served via jsDelivr at release tags).
packages/*/dist/
npm-debug.log*
*.log
.DS_Store
coverage/
lcov.info
